# 복사해서 .env로 쓰고 값을 채운다. .env는 저장소에 커밋하지 않는다(N3).
# 샌드박스 실행 방식: openshell(운영·시연) | local(개발용 흉내, 격리 없음·네트워크 접속 없음)
SANDBOX_MODE=local
SANDBOX_NAME=my-assistant
# NeMo Retriever 임베딩(KB 후보 검색). 비우면 문자 n-gram 검색으로 대체
NVIDIA_API_KEY=
# EMBED_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2
# 조사 타임아웃(초). 조사 60 + 설명 30 = PRD의 90초 예산
AGENT_TIMEOUT_S=60
EXPLAIN_TIMEOUT_S=30
# 개발 중 "조사 중단"을 흉내 내기: host=reason (agent_timeout|overloaded|agent_error|sandbox_error|policy_error)
# SIM_FORCE_INCOMPLETE=hanblt.example=overloaded
# 재생 모드 진행 속도 배율(기본 1.0, 약 9초)
# REPLAY_SPEED=1.0
