# 복사해서 .env로 쓰고 값을 채운다. .env는 저장소에 커밋하지 않는다(N3).
# 샌드박스 실행 방식: openshell(운영·시연) | local(개발용 흉내, 격리 없음·네트워크 접속 없음)
SANDBOX_MODE=local
SANDBOX_NAME=my-assistant
# NeMo Retriever 임베딩(KB 후보 검색). 비우면 문자 n-gram 검색으로 대체
NVIDIA_API_KEY=
# EMBED_MODEL=nvidia/nemotron-3-embed-1b
# 조사 타임아웃(초). 조사 60 + 설명 30 = PRD의 90초 예산
AGENT_TIMEOUT_S=60
EXPLAIN_TIMEOUT_S=30
# 개발 중 "조사 중단"을 흉내 내기: host=reason (agent_timeout|overloaded|agent_error|sandbox_error|policy_error)
# SIM_FORCE_INCOMPLETE=hanblt.example=overloaded
# 재생 모드 진행 속도 배율(기본 1.0, 약 9초)
# REPLAY_SPEED=1.0
# 요청 제한: 세션·클라이언트 IP별 분당 조사 요청 수 / 재생 모드 동시 실행 수 / 요청 본문 최대 바이트
# RATE_LIMIT_PER_MIN=6
# 클라이언트 IP를 모를 때(신뢰할 앞단이 없을 때) 전체 요청의 분당 합계 한도, 그리고 모든 클라이언트의 합계 한도
# RATE_LIMIT_UNTRUSTED_PER_MIN=20
# RATE_LIMIT_GLOBAL_PER_MIN=60
# REPLAY_MAX=3
# MAX_BODY_BYTES=32768
# 끝난 조사(문자 원문·결과)를 보관하는 시간. 지나면 자동 삭제
# RETENTION_HOURS=24
# 요청이 없어도 만료 기록을 지우는 주기(초), /api/health 점검 결과 캐시(초)
# PURGE_INTERVAL_S=600
# HEALTH_CACHE_S=15
