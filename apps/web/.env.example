# FastAPI 주소(서버에서만 사용, 브라우저에 노출되지 않음)
API_BASE_URL=http://127.0.0.1:8000
# 1이면 백엔드 없이 mocks/ 의 예시 데이터로 동작
API_MOCK=0
# HTTPS 없이 시연할 때만 0 (세션 쿠키의 Secure 속성을 끈다)
# COOKIE_SECURE=0
# 클라이언트 IP 헤더(X-Real-IP·X-Forwarded-For)를 믿을지. 앞단(nginx 등)이 이 헤더를 항상 덮어쓰고,
# 이 Next 서버로 앞단을 거치지 않고 들어오는 길이 막혀 있을 때만 1로 켠다. 끄면 IP를 넘기지 않고
# API가 모든 요청을 하나의 낮은 합계 한도(RATE_LIMIT_UNTRUSTED_PER_MIN)로 제한한다.
# TRUST_PROXY_HEADERS=1
